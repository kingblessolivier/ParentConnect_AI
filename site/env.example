# Copy to .env.local (gitignored) to turn the real AI coach on.
# Without this, the coach falls back to the safe, non-generative demo.

# Server-side only — NEVER prefix with NEXT_PUBLIC_ (that would expose it to the browser).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model the RAG coach uses. Defaults to claude-sonnet-5.
# Set claude-haiku-4-5 for the cheapest pilot, or claude-opus-5 for top quality.
# COACH_MODEL=claude-sonnet-5
